# ========================================================
# Utsav AI — environment configuration
# Copy to `.env.local` for local development. Never commit real keys.
# These are SERVER-SIDE variables (no VITE_ prefix) — they are never bundled into the browser.
# ========================================================

# Google Gemini (recommended). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.6-flash)
GEMINI_MODEL=

# Optional: local Ollama instead of Gemini (used only when GEMINI_API_KEY is empty)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:12b

# With neither configured, the app runs in clearly-labelled Demo mode using the
# built-in offline planner. Budgets, timelines and vendors work fully either way.
